# Copy to .env.local and fill in. Everything here is optional: without a key every module
# works and the "Explain this" button says it is not set up.

# Groq key for the "Explain this" feature. Server-side only (app/api/explain/route.ts).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Limits per minute. Defaults: 6 per visitor, 60 for the whole site.
# EXPLAIN_RATE_PER_MIN=6
# EXPLAIN_GLOBAL_PER_MIN=60

# How many reverse proxies sit in front of the app (Render/Vercel/nginx = 1). 0 trusts no
# forwarding headers. Keep it 0 when the app is reached directly, or visitors can fake their address.
# TRUSTED_PROXY_HOPS=0

# Extra origin allowed to call /api/explain (e.g. a separate front-end domain).
# ALLOWED_ORIGIN=https://your-domain.com

# Public URL used for social-share image links. Vercel sets VERCEL_URL itself.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
